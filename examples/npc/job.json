{
  "version": 1,
  "name": "cybersand-npc",
  "mode": "evaluate",
  "dataset": "inputs.jsonl",
  "output_dir": "runs",
  "concurrency": 2,
  "max_records": 100,
  "models": {
    "vision": {
      "model": "gpt-6.1-sol",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "billing": "free_expected",
      "pool": "premium",
      "reserve_input_tokens": 8000,
      "max_output_tokens": 1300,
      "image_token_reserve": 6500,
      "max_images": 12
    },
    "telemetry": {
      "model": "gpt-5.6-terra",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "billing": "free_expected",
      "pool": "secondary",
      "reserve_input_tokens": 8000,
      "max_output_tokens": 900
    }
  },
  "reviewers": [
    {
      "id": "visible-behaviour",
      "model": "vision",
      "prompt": "vision-review.md",
      "min_score": 0.85,
      "include_images": true
    },
    {
      "id": "measured-behaviour",
      "model": "telemetry",
      "prompt": "telemetry-review.md",
      "min_score": 0.85,
      "include_images": false
    }
  ],
  "budgets": {
    "daily_premium_tokens": 250000,
    "daily_secondary_tokens": 2500000,
    "monthly_paid_usd": 88,
    "run_paid_usd": 8,
    "cycle_start_day": 1
  }
}
