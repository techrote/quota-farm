{
  "version": 1,
  "name": "game-artifact",
  "mode": "generate_review",
  "dataset": "inputs.jsonl",
  "output_dir": "runs",
  "concurrency": 4,
  "max_records": 100,
  "models": {
    "generator": {
      "model": "gpt-5.6-terra",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "billing": "free_expected",
      "pool": "secondary",
      "reserve_input_tokens": 4096,
      "max_output_tokens": 1500
    },
    "format": {
      "model": "gpt-5.6-terra",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "billing": "free_expected",
      "pool": "secondary",
      "reserve_input_tokens": 10000,
      "max_output_tokens": 600
    },
    "semantic": {
      "model": "gpt-6.1-sol",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "billing": "free_expected",
      "pool": "premium",
      "reserve_input_tokens": 12000,
      "max_output_tokens": 700
    }
  },
  "generator": {
    "model": "generator",
    "prompt": "generate.md"
  },
  "reviewers": [
    {
      "id": "syntax",
      "model": "format",
      "prompt": "review.md",
      "min_score": 0.9,
      "include_images": false
    }
  ],
  "budgets": {
    "daily_premium_tokens": 250000,
    "daily_secondary_tokens": 2500000,
    "monthly_paid_usd": 88,
    "run_paid_usd": 8,
    "cycle_start_day": 1
  }
}
